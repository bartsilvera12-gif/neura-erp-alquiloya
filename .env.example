# Supabase (instancia AlquiloYa o cualquier proyecto Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Performance auth (opt-in): valida el access token localmente (firma + exp) en vez de
# pegarle a /auth/v1/user en cada request. OFF por default → comportamiento histórico.
#   NEURA_USE_LOCAL_JWT=1  activa el fast-path (fallback automático a auth.getUser() si falla).
#   SUPABASE_JWT_SECRET    requerido si el proyecto usa JWT simétrico HS256.
#                          (si son asimétricas, se usa el JWKS del proyecto, sin esta var)
NEURA_USE_LOCAL_JWT=
SUPABASE_JWT_SECRET=

# Configuración de instancia NEURA
# NEURA_INSTANCE_MODE: "multi_client" (default si no se setea) | "single_client"
# NEURA_CLIENT_SCHEMA: schema PostgREST de la instancia (default "zentra_erp")
# NEURA_CLIENT_NAME:   nombre humano para branding/UI
NEURA_INSTANCE_MODE=single_client
NEURA_CLIENT_SCHEMA=alquiloya
NEURA_CLIENT_NAME=AlquiloYa

# Hosts públicos que sirven la web legacy AlquiloYa en "/"
# (coma-separados, sin protocolo ni puerto). Si el header `host` matchea,
# el middleware reescribe "/" -> "/alquiloya-legacy/index.html".
NEURA_PUBLIC_HOSTS=alquiloya.com.py,www.alquiloya.com.py

# =========================================================================
# Integracion Meta (Facebook Pages + Instagram Business/Creator)
# Ver docs/META_INTEGRATION.md para instrucciones de configuracion completa.
# =========================================================================

# App ID / Secret de la app Meta Business en developers.facebook.com
META_APP_ID=
META_APP_SECRET=

# URL adonde Meta redirige despues del consent. Debe estar en la lista de
# "Valid OAuth Redirect URIs" de la app en Meta Developers.
META_REDIRECT_URI=https://alquiloya.neura.com.py/api/integraciones/meta/oauth/callback

# Version de Graph API. Actualizarla requiere revisar breaking changes en
# https://developers.facebook.com/docs/graph-api/changelog/
META_GRAPH_API_VERSION=v21.0

# Clave para cifrar los access_tokens de Meta antes de guardarlos en DB
# (AES-256-GCM con KDF scrypt). Minimo 16 chars — recomendado 32+ aleatorios.
# Generar: `openssl rand -base64 32`
META_SECRETS_KEY=

# Secreto compartido entre Coolify Scheduled Task y el worker interno de
# publicacion. Se envia en el header x-worker-secret. Se usa en Entrega 2.
INTERNAL_WORKER_SECRET=
